    "shop_slot": {
        "type": "panel",
        "size": [
            "100%",
            "100%"
        ],
        "$weapon_name": "Weapon",
        "$weapon_price": "0",
        "bindings": [
            {
                "binding_name": "#form_button_text",
                "binding_name_override": "#shop_state_text",
                "binding_type": "collection",
                "binding_collection_name": "form_buttons"
            },
            {
                "binding_type": "view",
                "source_property_name": "((#shop_state_text - 'HIDDEN:') = #shop_state_text)",
                "target_property_name": "#visible"
            }
        ],
        "controls": [
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/White",
                    "color": [
                        0.16,
                        0.12,
                        0.13
                    ],
                    "alpha": 0.58,
                    "size": [
                        "99%",
                        "98%"
                    ],
                    "anchor_from": "center",
                    "anchor_to": "center"
                }
            },
            {
                "image_placeholder": {
                    "type": "image",
                    "texture": "textures/ui/White",
                    "color": [
                        1.0,
                        1.0,
                        1.0
                    ],
                    "alpha": 1.0,
                    "size": [
                        "58%",
                        "36%"
                    ],
                    "anchor_from": "center",
                    "anchor_to": "center",
                    "offset": [
                        0,
                        -3
                    ],
                    "keep_ratio": true,
                    "bindings": [
                        {
                            "binding_name": "#form_button_texture",
                            "binding_name_override": "#texture",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_name": "#form_button_texture_file_system",
                            "binding_name_override": "#texture_file_system",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "name": {
                    "type": "label",
                    "text": "$weapon_name",
                    "font_size": "small",
                    "color": [
                        0.78,
                        0.76,
                        0.76
                    ],
                    "shadow": true,
                    "size": [
                        "60%",
                        12
                    ],
                    "anchor_from": "bottom_left",
                    "anchor_to": "bottom_left",
                    "offset": [
                        5,
                        -4
                    ]
                }
            },
            {
                "price_available": {
                    "type": "label",
                    "text": "$weapon_price",
                    "font_size": "small",
                    "color": [
                        1.0,
                        0.78,
                        0.15
                    ],
                    "shadow": true,
                    "size": [
                        "38%",
                        12
                    ],
                    "text_alignment": "right",
                    "anchor_from": "bottom_right",
                    "anchor_to": "bottom_right",
                    "offset": [
                        -5,
                        -4
                    ],
                    "bindings": [
                        {
                            "binding_name": "#form_button_text",
                            "binding_name_override": "#shop_state_text",
                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "(not ((#shop_state_text - 'BUYABLE:') = #shop_state_text))",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "price_unavailable": {
                    "type": "label",
                    "text": "$weapon_price",
                    "font_size": "small",
                    "color": [
                        1.0,
                        0.16,
                        0.12
                    ],
                    "shadow": true,
                    "size": [
                        "38%",
                        12
                    ],
                    "text_alignment": "right",
                    "anchor_from": "bottom_right",
