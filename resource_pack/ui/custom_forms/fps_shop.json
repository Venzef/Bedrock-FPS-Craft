                            "binding_type": "collection",
                            "binding_collection_name": "form_buttons"
                        },
                        {
                            "binding_type": "view",
                            "source_property_name": "((#shop_state_text - 'BUYABLE:') = #shop_state_text)",
                            "target_property_name": "#visible"
                        }
                    ]
                }
            },
            {
                "click@fps_shop.shop_slot_button": {
                    "layer": 100
                }
            }
        ]
